/* Native diagnostic for the wishing well's plain display lists. Use the same
 * parts, materials, foliage, scroll segments and rear repair as its actor.
 * Water is emitted after solids on this viewer stream so it inherits the
 * viewer camera/lights; its original DLs still select translucent blending. */
extern u16 mFM_obj_tree_01_pal_dol[14][16];
extern u8 obj_s_tree3_leaf_tex[], obj_w_tree_leaf_tex[];
extern Gfx* pc_shrine_back_dl(Gfx* original);
#define MV_SHRINE_PARTS(s) \
    extern Gfx obj_##s##_shrine_bubble_model[], obj_##s##_shrine_trunk_model[]; \
    extern Gfx obj_##s##_shrine_leaf_model[], obj_##s##_shrine_figure_model[]; \
    extern Gfx obj_##s##_shrine_base_model[], obj_##s##_shrine_statue_model[]; \
    extern Gfx obj_##s##_shrine_water_model[], obj_##s##_shrine_sprash_model[];
MV_SHRINE_PARTS(s) MV_SHRINE_PARTS(w)
#undef MV_SHRINE_PARTS

static void mv_draw_shrine(GAME* game, int winter, int solid) {
    GRAPH* graph = game->graph;
    Gfx* parts[8];
    Gfx* scroll0 = two_tex_scroll_dolphin(graph, 0, 0, 0, 32, 16, 1, 0, 0, 32, 16);
    Gfx* scroll1 = two_tex_scroll_dolphin(graph, 0, 0, 0, 32, 16, 1, 0, 0, 32, 16);
    Gfx* scroll2 = two_tex_scroll_dolphin(graph, 0, 0, 0, 16, 64, 1, 0, 0, 0, 0);
    int i;
#define MV_SHRINE_SELECT(part) (winter ? obj_w_shrine_##part##_model : obj_s_shrine_##part##_model)
    parts[0] = MV_SHRINE_SELECT(bubble);
    parts[1] = MV_SHRINE_SELECT(trunk);
    parts[2] = MV_SHRINE_SELECT(leaf);
    parts[3] = MV_SHRINE_SELECT(figure);
    parts[4] = MV_SHRINE_SELECT(base);
    parts[5] = MV_SHRINE_SELECT(statue);
    parts[6] = MV_SHRINE_SELECT(water);
    parts[7] = MV_SHRINE_SELECT(sprash);
#undef MV_SHRINE_SELECT
    /* Match aSHR_actor_draw's opaque palette mode, rather than the generic
     * model viewer pipeline (which disables the TLUT). */
    _texture_z_light_fog_prim_npc(graph);
    OPEN_DISP(graph);
    gDPSetTextureAdjustMode(NOW_POLY_OPA_DISP++, G_TA_DOLPHIN);
    gDPSetTexEdgeAlpha(NOW_POLY_OPA_DISP++, 112);
    gSPSegment(NOW_POLY_OPA_DISP++, G_MWO_SEGMENT_9, mFM_obj_tree_01_pal_dol[winter ? 10 : 2]);
    gSPSegment(NOW_POLY_OPA_DISP++, G_MWO_SEGMENT_A, winter ? obj_w_tree_leaf_tex : obj_s_tree3_leaf_tex);
    gSPSegment(NOW_POLY_OPA_DISP++, G_MWO_SEGMENT_B, scroll2);
    gSPSegment(NOW_POLY_OPA_DISP++, G_MWO_SEGMENT_C, scroll0);
    gSPSegment(NOW_POLY_OPA_DISP++, G_MWO_SEGMENT_D, scroll1);

    /* Explicit diagnostic baseline only. Production no longer reflects these
     * five unrelated parts around their combined tree-and-basin center. */
    if (solid == 2) {
        extern int pc_solid_shell_measure_dls(Gfx* const*, int, f32*);
        extern int g_pc_solid_shell_pct;
        f32 center[3];
        if (pc_solid_shell_measure_dls(parts + 1, 5, center)) {
            f32 scale = g_pc_solid_shell_pct * 0.01f;
            Matrix_push();
            Matrix_translate(center[0], center[1], center[2], MTX_MULT);
            Matrix_scale(scale, scale, -scale, MTX_MULT);
            Matrix_translate(-center[0], -center[1], -center[2], MTX_MULT);
            gSPMatrix(NOW_POLY_OPA_DISP++, _Matrix_to_Mtx_new(graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
            Matrix_pull();
            for (i = 1; i <= 5; ++i) gSPDisplayList(NOW_POLY_OPA_DISP++, parts[i]);
        }
    }
    CLOSE_DISP(graph);
    if (solid == 2) _texture_z_light_fog_prim_npc(graph);
    OPEN_DISP(graph);
    gSPMatrix(NOW_POLY_OPA_DISP++, _Matrix_to_Mtx_new(graph), G_MTX_NOPUSH | G_MTX_LOAD | G_MTX_MODELVIEW);
    for (i = 0; i < 6; ++i) {
        Gfx* rear;
        gSPDisplayList(NOW_POLY_OPA_DISP++, parts[i]);
        rear = solid == 1 ? pc_shrine_back_dl(parts[i]) : NULL;
        if (rear) gSPDisplayList(NOW_POLY_OPA_DISP++, rear);
    }
    CLOSE_DISP(graph);
    /* The actor uses the ordinary XLU pipeline for its I4 water effects. */
    _texture_z_light_fog_prim(graph);
    OPEN_DISP(graph);
    gDPSetTextureAdjustMode(NOW_POLY_OPA_DISP++, G_TA_N64);
    gSPDisplayList(NOW_POLY_OPA_DISP++, parts[6]);
    gSPDisplayList(NOW_POLY_OPA_DISP++, parts[7]);
    gSPDisplayList(NOW_POLY_OPA_DISP++, parts[0]);
    gDPSetTextureAdjustMode(NOW_POLY_OPA_DISP++, G_TA_N64);
    gDPSetTexEdgeAlpha(NOW_POLY_OPA_DISP++, 144);
    CLOSE_DISP(graph);
}
