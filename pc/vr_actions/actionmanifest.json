{
  "default_bindings": [
    {
      "controller_type": "oculus_touch",
      "binding_url": "bindings_oculus_touch.json"
    },
    {
      "controller_type": "knuckles",
      "binding_url": "bindings_knuckles.json"
    }
  ],
  "actions": [
    { "name": "/actions/main/in/move",     "type": "vector2",  "requirement": "mandatory" },
    { "name": "/actions/main/in/camera",   "type": "vector2" },
    { "name": "/actions/main/in/a",        "type": "boolean",  "requirement": "mandatory" },
    { "name": "/actions/main/in/b",        "type": "boolean",  "requirement": "mandatory" },
    { "name": "/actions/main/in/x",        "type": "boolean" },
    { "name": "/actions/main/in/y",        "type": "boolean" },
    { "name": "/actions/main/in/l",        "type": "boolean" },
    { "name": "/actions/main/in/r",        "type": "boolean" },
    { "name": "/actions/main/in/z",        "type": "boolean" },
    { "name": "/actions/main/in/start",    "type": "boolean" },
    { "name": "/actions/main/in/recenter", "type": "boolean" },
    { "name": "/actions/main/out/haptic_left",  "type": "vibration" },
    { "name": "/actions/main/out/haptic_right", "type": "vibration" }
  ],
  "action_sets": [
    { "name": "/actions/main", "usage": "leftright" }
  ],
  "localization": [
    {
      "language_tag": "en_US",
      "/actions/main": "Animal Crossing",
      "/actions/main/in/move": "Move (Stick)",
      "/actions/main/in/camera": "Camera (C-Stick)",
      "/actions/main/in/a": "A Button",
      "/actions/main/in/b": "B Button",
      "/actions/main/in/x": "X Button",
      "/actions/main/in/y": "Y Button",
      "/actions/main/in/l": "L Trigger (hold: stick = D-Pad)",
      "/actions/main/in/r": "R Trigger",
      "/actions/main/in/z": "Z Trigger",
      "/actions/main/in/start": "Start",
      "/actions/main/in/recenter": "Recenter View",
      "/actions/main/out/haptic_left": "Left Haptics",
      "/actions/main/out/haptic_right": "Right Haptics"
    }
  ]
}
