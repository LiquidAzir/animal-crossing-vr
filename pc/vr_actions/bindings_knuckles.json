{
  "controller_type": "knuckles",
  "description": "Default Animal Crossing VR bindings for Valve Index controllers",
  "name": "Animal Crossing VR - Index",
  "bindings": {
    "/actions/main": {
      "sources": [
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/main/in/move" },
            "click":    { "output": "/actions/main/in/start" }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": { "output": "/actions/main/in/camera" },
            "click":    { "output": "/actions/main/in/z" }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/a" }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/b" }
          }
        },
        {
          "path": "/user/hand/right/input/a",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/a" }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/b" }
          }
        },
        {
          "path": "/user/hand/left/input/a",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/x" }
          }
        },
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/y" }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/l" }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "inputs": {
            "click": { "output": "/actions/main/in/r" }
          }
        }
      ],
      "haptics": [
        { "path": "/user/hand/left/output/haptic",  "output": "/actions/main/out/haptic_left" },
        { "path": "/user/hand/right/output/haptic", "output": "/actions/main/out/haptic_right" }
      ],
      "poses": [
        { "output": "/actions/main/in/hand_right", "path": "/user/hand/right/pose/tip" },
        { "output": "/actions/main/in/empty_hand_left", "path": "/user/hand/left/pose/handgrip" },
        { "output": "/actions/main/in/empty_hand_right", "path": "/user/hand/right/pose/handgrip" }
      ]
    }
  }
}
