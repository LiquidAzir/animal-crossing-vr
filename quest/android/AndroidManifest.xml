<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.liquidazir.animalcrossingquest"
    android:versionCode="1" android:versionName="0.1.0-dev" android:installLocation="auto">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="32" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
    </queries>
    <application android:label="Animal Crossing Quest (Development)"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:debuggable="true" android:allowBackup="false"
        android:extractNativeLibs="true" android:hardwareAccelerated="true">
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest3" />
        <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only" />
        <meta-data android:name="com.oculus.intent.category.VR" android:value="vr_only" />
        <activity android:name="com.liquidazir.animalcrossingquest.QuestActivity"
            android:exported="true" android:launchMode="singleTask"
            android:screenOrientation="landscape" android:alwaysRetainTaskState="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
