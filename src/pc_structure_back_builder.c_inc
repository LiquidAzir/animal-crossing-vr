/* Shared builder for fitted missing surfaces. Callers provide original disc
 * vertices, a material crop, and either a fixed or live seasonal palette. */
typedef struct {
    u8 index;
    s16 offset[3];
    s16 uv[2]; /* texel coordinates in the cropped 32x32 material */
} pc_structure_back_vertex;

typedef struct {
    const u8* texture;
    u16 texture_width;
    u8 crop[4]; /* inclusive source texels */
    u8 vertex_count, triangle_count;
    pc_structure_back_vertex vertices[8];
    u8 triangles[18];
} pc_structure_back_patch;

typedef struct {
    const Vtx* source;
    unsigned patch_count;
    const pc_structure_back_patch* patches;
    const u16* palette; /* NULL uses the live structure palette in segment 8. */
} pc_structure_back_spec;

typedef struct {
    Vtx vertices[6][8];
    u8 textures[6][512];
    Gfx list[128];
    int ready;
} pc_structure_back_cache;

static unsigned pc_structure_ci4_pixel(unsigned x, unsigned y, unsigned width) {
    return ((y / 8) * (width / 8) + x / 8) * 64 + (y % 8) * 8 + x % 8;
}

static Gfx* pc_structure_back_build_spec(const pc_structure_back_spec* spec,
                                         pc_structure_back_cache* cache) {
    Gfx* dl = cache->list;
    unsigned p;
    if (cache->ready) return cache->list;
    for (p = 0; p < spec->patch_count; ++p) {
        const pc_structure_back_patch* patch = &spec->patches[p];
        Vtx* vertices = cache->vertices[p];
        f32 normals[8][3] = {{0}};
        unsigned i, j, x, y;
        /* Unloaded disc assets are all zero. In particular, don't build the
         * tailor's relative corners until the original model is available. */
        int available = 0;
        for (i = 0; i < patch->vertex_count; ++i) {
            const pc_structure_back_vertex* ref = &patch->vertices[i];
            vertices[i] = spec->source[ref->index];
            for (j = 0; j < 3; ++j) {
                if (vertices[i].v.ob[j] != 0) available = 1;
                vertices[i].v.ob[j] += ref->offset[j];
            }
            vertices[i].v.tc[0] = ref->uv[0] * 32;
            vertices[i].v.tc[1] = ref->uv[1] * 32;
            vertices[i].n.a = 255;
        }
        if (!available) return NULL;
        for (i = 0; i < patch->triangle_count; ++i) {
            const u8* t = patch->triangles + i * 3;
            f32 a[3], b[3], n[3];
            for (j = 0; j < 3; ++j) {
                a[j] = vertices[t[1]].v.ob[j] - vertices[t[0]].v.ob[j];
                b[j] = vertices[t[2]].v.ob[j] - vertices[t[0]].v.ob[j];
            }
            n[0] = a[1]*b[2] - a[2]*b[1];
            n[1] = a[2]*b[0] - a[0]*b[2];
            n[2] = a[0]*b[1] - a[1]*b[0];
            for (j = 0; j < 3; ++j) {
                normals[t[0]][j] += n[j];
                normals[t[1]][j] += n[j];
                normals[t[2]][j] += n[j];
            }
        }
        for (i = 0; i < patch->vertex_count; ++i) {
            f32* n = normals[i];
            f32 len = sqrtf(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);
            if (len <= 0.0f) return NULL;
            for (j = 0; j < 3; ++j) vertices[i].n.n[j] = (s8)(127.0f * n[j] / len);
        }
        for (y = 0; y < 32; ++y) for (x = 0; x < 32; ++x) {
            unsigned sx = patch->crop[0] + x * (patch->crop[2] - patch->crop[0]) / 31;
            unsigned sy = patch->crop[1] + y * (patch->crop[3] - patch->crop[1]) / 31;
            unsigned src = pc_structure_ci4_pixel(sx, sy, patch->texture_width);
            unsigned dst = pc_structure_ci4_pixel(x, y, 32);
            u8 index = (patch->texture[src / 2] >> ((src & 1) ? 0 : 4)) & 15;
            if (dst & 1) cache->textures[p][dst / 2] |= index;
            else cache->textures[p][dst / 2] = index << 4;
        }
        gDPPipeSync(dl++);
        gSPTexture(dl++, 0, 0, 0, G_TX_RENDERTILE, G_ON);
        gDPSetCombineLERP(dl++, TEXEL0, 0, SHADE, 0, 0, 0, 0, TEXEL0,
                         PRIMITIVE, 0, COMBINED, 0, 0, 0, 0, COMBINED);
        gDPSetRenderMode(dl++, G_RM_FOG_SHADE_A, G_RM_AA_ZB_OPA_SURF2);
        /* GBI distinguishes integer segment addresses from host pointers by
         * expression type. Keep these separate: a pointer-typed conditional
         * would incorrectly tag segment 8 as the host address 0x08000000. */
        if (spec->palette) {
            gDPLoadTLUT_Dolphin(dl++, 15, 16, 1, spec->palette);
        } else {
            gDPLoadTLUT_Dolphin(dl++, 15, 16, 1, anime_1_txt);
        }
        gDPSetTextureImage_Dolphin(dl++, G_IM_FMT_CI, G_IM_SIZ_4b, 32, 32, cache->textures[p]);
        gDPSetTile_Dolphin(dl++, G_DOLPHIN_TLUT_DEFAULT_MODE, 0, 15, GX_MIRROR, GX_MIRROR, 0, 0);
        gDPSetPrimColor(dl++, 0, 128, 255, 255, 255, 255);
        gSPLoadGeometryMode(dl++, G_ZBUFFER | G_SHADE | G_CULL_BACK | G_FOG | G_LIGHTING | G_SHADING_SMOOTH);
        gSPVertex(dl++, vertices, patch->vertex_count, 0);
        for (i = 0; i < patch->triangle_count; ++i) {
            const u8* t = patch->triangles + i * 3;
            gSP1Triangle(dl++, t[0], t[1], t[2], 0);
        }
    }
    gSPEndDisplayList(dl++);
    cache->ready = 1;
    return cache->list;
}
