/* The basin already has a complete ring. Only the tree's three open rear
 * boundaries and the stone backing need faces. Keep every original vertex in
 * place: reflecting the entire fixture moves a second tree into the water. */
extern Vtx obj_s_shrine_v[], obj_w_shrine_v[];
extern Gfx obj_s_shrine_trunk_model[], obj_w_shrine_trunk_model[];
extern Gfx obj_s_shrine_figure_model[], obj_w_shrine_figure_model[];

static const u16 pc_shrine_trunk_rim[] = {
    272,271,273,274,277,254,255,257,258,
    280,282,283,279,278,285,281,
    291,290,289,288,287,293,292
};
static const u8 pc_shrine_trunk_faces[] = {
    8,0,1, 2,3,4, 2,4,5, 1,2,5, 1,5,6, 1,6,7, 1,7,8,
    /* The bent branch rims are nonplanar. Triangulate in their fitted plane
     * and avoid diagonals already used by the original branch surface. */
    15,9,10, 15,10,11, 15,11,12, 12,13,14, 12,14,15,
    16,17,18, 22,16,18, 22,18,19, 22,19,20, 20,21,22
};
static const u16 pc_shrine_figure_rim[] = {392,385,384,379,383,382,387,391};
static const u8 pc_shrine_figure_faces[] = {
    7,0,1, 7,1,2, 7,2,3, 7,3,4, 7,4,5, 5,6,7
};

/* Emit immediately after the matching original DL to retain its seasonal
 * texture, palette, primitive color, and pipeline. Unknown parts are untouched.
 * Exported for the native model viewer to exercise this same production path. */
Gfx* pc_shrine_back_dl(Gfx* original) {
    static Gfx* const models[4] = {
        obj_s_shrine_trunk_model, obj_s_shrine_figure_model,
        obj_w_shrine_trunk_model, obj_w_shrine_figure_model
    };
    static Vtx rear_vertices[4][23];
    static Gfx rear_lists[4][19];
    static u8 ready[4];
    int model;

    for (model = 0; model < 4; ++model) {
        if (models[model] == original) {
            if (!ready[model]) {
                int figure = model & 1;
                const u16* rim = figure ? pc_shrine_figure_rim : pc_shrine_trunk_rim;
                const u8* faces = figure ? pc_shrine_figure_faces : pc_shrine_trunk_faces;
                int count = figure ? 8 : 23;
                int face_count = figure ? 6 : 17;
                Vtx* src = model < 2 ? obj_s_shrine_v : obj_w_shrine_v;
                Vtx* dst = rear_vertices[model];
                f32 normals[23][3] = {{0}};
                Gfx* out = rear_lists[model];
                int i, axis, group;

                /* All loops have nonzero height after the disc assets load. */
                if (src[rim[1]].v.ob[1] == src[rim[0]].v.ob[1]) return NULL;
                for (i = 0; i < count; ++i) dst[i] = src[rim[i]];
                gSPVertex(out++, dst, count, 0);
                for (i = 0; i < face_count; ++i) {
                    const u8* tri = faces + i*3;
                    f32 a[3], b[3], n[3];
                    for (axis = 0; axis < 3; ++axis) {
                        a[axis] = dst[tri[1]].v.ob[axis] - dst[tri[0]].v.ob[axis];
                        b[axis] = dst[tri[2]].v.ob[axis] - dst[tri[0]].v.ob[axis];
                    }
                    n[0] = a[1]*b[2] - a[2]*b[1];
                    n[1] = a[2]*b[0] - a[0]*b[2];
                    n[2] = a[0]*b[1] - a[1]*b[0];
                    for (axis = 0; axis < 3; ++axis) {
                        normals[tri[0]][axis] += n[axis];
                        normals[tri[1]][axis] += n[axis];
                        normals[tri[2]][axis] += n[axis];
                    }
                    gSP1Triangle(out++, tri[0], tri[1], tri[2], 0);
                }
                gSPEndDisplayList(out++);

                /* Project each closure into an opaque patch of its own atlas.
                 * The trunk atlas's left half is a transparent branch cutout;
                 * the figure atlas also contains a plaque and openings. Keep
                 * those front details out of the new bark/stone rear faces. */
                for (group = 0; group < (figure ? 1 : 3); ++group) {
                    int first = figure || group == 0 ? 0 : group == 1 ? 9 : 16;
                    int end = figure ? 8 : group == 0 ? 9 : group == 1 ? 16 : 23;
                    f32 min_x = dst[first].v.ob[0], max_x = min_x;
                    f32 min_y = dst[first].v.ob[1], max_y = min_y;
                    for (i = first + 1; i < end; ++i) {
                        if (dst[i].v.ob[0] < min_x) min_x = dst[i].v.ob[0];
                        if (dst[i].v.ob[0] > max_x) max_x = dst[i].v.ob[0];
                        if (dst[i].v.ob[1] < min_y) min_y = dst[i].v.ob[1];
                        if (dst[i].v.ob[1] > max_y) max_y = dst[i].v.ob[1];
                    }
                    if (max_x <= min_x || max_y <= min_y) return NULL;
                    for (i = first; i < end; ++i) {
                        f32 u = (dst[i].v.ob[0] - min_x) / (max_x - min_x);
                        f32 v = (max_y - dst[i].v.ob[1]) / (max_y - min_y);
                        dst[i].v.tc[0] = (s16)(32.0f * (figure ? 114.0f + 12.0f*u : 72.0f + 52.0f*u));
                        dst[i].v.tc[1] = (s16)(32.0f * (figure ? 19.0f + 11.0f*v : 3.0f + 26.0f*v));
                    }
                }
                for (i = 0; i < count; ++i) {
                    f32* n = normals[i];
                    f32 len = sqrtf(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);
                    if (len > 0.0f)
                        for (axis = 0; axis < 3; ++axis) dst[i].n.n[axis] = (s8)(127.0f*n[axis]/len);
                }
                ready[model] = TRUE;
            }
            return rear_lists[model];
        }
    }
    return NULL;
}
