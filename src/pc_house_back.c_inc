/* Missing rear walls of the five villager houses and four player homes.
 * Each cap joins vertices on the ORIGINAL rear opening, in the same skeleton
 * frame. No copied roof, door, porch, fence, or decoration is rendered.
 * Seasonal indices differ even when the boundary positions are identical.
 * Source vertices/textures are loaded from the user's disc; never modified.
 *
 * Opaque wall and timber samples retain the live house palette. Samples repeat
 * at their original scale instead of stretching a tiny swatch over a whole
 * building. Plaster homes receive matching timber around their rear outline.
 * See pc/tests/run_vr_house_tests.py for asset-backed topology/material checks. */
#define PC_HOUSE_BACK_SYMBOLS(season, kind, tex) \
    extern cKF_Skeleton_R_c cKF_bs_r_obj_##season##_##kind; \
    extern Vtx obj_##season##_##kind##_v[]; \
    extern u8 obj_##season##_##kind##_##tex##_tex_txt[];
#define PC_HOUSE_BACK_SEASON(season) \
    PC_HOUSE_BACK_SYMBOLS(season, house1, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, house2, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, house3, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, house4, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, house5, t1) \
    PC_HOUSE_BACK_SYMBOLS(season, myhome1, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, myhome2, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, myhome3, t2) \
    PC_HOUSE_BACK_SYMBOLS(season, myhome4, t2)
PC_HOUSE_BACK_SEASON(s)
PC_HOUSE_BACK_SEASON(w)
#undef PC_HOUSE_BACK_SYMBOLS
#undef PC_HOUSE_BACK_SEASON

typedef struct {
    cKF_Skeleton_R_c* skeleton;
    Vtx* source;
    u8* texture;
    u16 source_count;
    u8 vertex_count, triangle_count;
    u8 indices[12];
    u8 triangles[24];
    u8 crop[4]; /* inclusive original 128x32 atlas texels: x0,y0,x1,y1 */
    u8 timber[4]; /* optional opaque timber strip in the same atlas */
    u16 texel_units; /* model-space units per original atlas texel */
    u16 beam_height; /* matching wall/eave crossbeam; zero means no timber frame */
    u8 stagger; /* stagger short plaster rows instead of forming vertical stripes */
} pc_house_back_spec;

#include "pc_house_back_data.c_inc"

typedef struct {
    Vtx vertices[12];
    u8 texture[2048]; /* GX CI4, 64x64, opaque under every house palette */
    Gfx list[32];
    int ready;
} pc_house_back_cache;
static pc_house_back_cache pc_house_back_cache_data[ARRAY_COUNT(pc_house_back_specs)];

static unsigned pc_house_ci4_pixel(int x, int y, int width) {
    return ((y / 8) * (width / 8) + x / 8) * 64 + (y % 8) * 8 + x % 8;
}

/* Mirrored samples join without a hard wrap seam and never address another
 * part of the atlas (especially its transparent windows and door openings). */
static int pc_house_sample_coord(int value, int count) {
    int n = value % (count * 2);
    if (n < 0) n += count * 2;
    return n < count ? n : count * 2 - 1 - n;
}

static u8 pc_house_material_sample(const u8* texture, const u8* crop, int x, int y) {
    int sx = crop[0] + pc_house_sample_coord(x, crop[2] - crop[0] + 1);
    int sy = crop[1] + pc_house_sample_coord(y, crop[3] - crop[1] + 1);
    unsigned src = pc_house_ci4_pixel(sx, sy, 128);
    return (texture[src / 2] >> ((src & 1) ? 0 : 4)) & 15;
}

static f32 pc_house_edge_distance(f32 y, f32 z, const Vtx* a, const Vtx* b) {
    f32 dy = b->v.ob[1] - a->v.ob[1], dz = b->v.ob[2] - a->v.ob[2];
    f32 len2 = dy*dy + dz*dz;
    f32 t = len2 > 0 ? ((y-a->v.ob[1])*dy + (z-a->v.ob[2])*dz) / len2 : 0;
    if (t < 0) t = 0;
    if (t > 1) t = 1;
    dy = y - a->v.ob[1] - t*dy;
    dz = z - a->v.ob[2] - t*dz;
    return sqrtf(dy*dy + dz*dz);
}

/* Returns true for known residences even while assets are unavailable: they
 * must NEVER fall back to the overlapping whole-building mirror. */
static int pc_house_back_lookup(cKF_Skeleton_R_c* skeleton, Gfx** out) {
    int model;
    *out = NULL;
    for (model = 0; model < ARRAY_COUNT(pc_house_back_specs); model++) {
        const pc_house_back_spec* spec = &pc_house_back_specs[model];
        pc_house_back_cache* cache = &pc_house_back_cache_data[model];
        if (spec->skeleton != skeleton) continue;
        if (!cache->ready) {
            f32 normals[12][3] = {{0}};
            u8 edges[12][12] = {{0}};
            f32 min_y = 32767, max_y = -32768, min_z = 32767, max_z = -32768;
            Gfx* dl = cache->list;
            int i, j, x, y;
            for (i = 0; i < spec->vertex_count; i++) {
                Vtx* v = &cache->vertices[i];
                *v = spec->source[spec->indices[i]];
                if (v->v.ob[1] < min_y) min_y = v->v.ob[1];
                if (v->v.ob[1] > max_y) max_y = v->v.ob[1];
                if (v->v.ob[2] < min_z) min_z = v->v.ob[2];
                if (v->v.ob[2] > max_z) max_z = v->v.ob[2];
            }
            if (max_y <= min_y || max_z <= min_z) return 1; /* retry after loading */
            for (i = 0; i < spec->triangle_count; i++) {
                const u8* tri = spec->triangles + i * 3;
                f32 a[3], b[3], n[3];
                for (j = 0; j < 3; j++) {
                    a[j] = cache->vertices[tri[1]].v.ob[j] - cache->vertices[tri[0]].v.ob[j];
                    b[j] = cache->vertices[tri[2]].v.ob[j] - cache->vertices[tri[0]].v.ob[j];
                }
                n[0] = a[1]*b[2] - a[2]*b[1];
                n[1] = a[2]*b[0] - a[0]*b[2];
                n[2] = a[0]*b[1] - a[1]*b[0];
                for (j = 0; j < 3; j++) {
                    normals[tri[0]][j] += n[j];
                    normals[tri[1]][j] += n[j];
                    normals[tri[2]][j] += n[j];
                }
                for (j = 0; j < 3; j++) {
                    int a = tri[j], b = tri[(j+1)%3];
                    if (a < b) edges[a][b]++;
                    else edges[b][a]++;
                }
            }
            for (i = 0; i < spec->vertex_count; i++) {
                Vtx* v = &cache->vertices[i];
                f32* n = normals[i];
                f32 len = sqrtf(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);
                if (len <= 0.0f) return 1;
                /* The authored roofs/walls are smooth at this boundary. Join
                 * their normals instead of creating an abrupt, uniformly dark
                 * plane. Keep the eave underside's intentional hard seam. */
                if (n[0] < 0.0f) {
                    const Vtx* original = &spec->source[spec->indices[i]];
                    f32 source_len = sqrtf((f32)original->n.n[0]*original->n.n[0] +
                                          (f32)original->n.n[1]*original->n.n[1] +
                                          (f32)original->n.n[2]*original->n.n[2]);
                    if (source_len > 0.0f) {
                        for (j = 0; j < 3; j++)
                            n[j] = n[j] / len + 0.75f * original->n.n[j] / source_len;
                        len = sqrtf(n[0]*n[0] + n[1]*n[1] + n[2]*n[2]);
                    }
                }
                for (j = 0; j < 3; j++) v->n.n[j] = (s8)(n[j] * 127.0f / len);
                v->n.a = 255;
                v->v.tc[0] = (s16)((v->v.ob[2] - min_z) * (63.0f * 32.0f) / (max_z - min_z));
                v->v.tc[1] = (s16)((max_y - v->v.ob[1]) * (63.0f * 32.0f) / (max_y - min_y));
            }
            for (y = 0; y < 64; y++) for (x = 0; x < 64; x++) {
                f32 wy = max_y - y * (max_y - min_y) / 63.0f;
                f32 wz = min_z + x * (max_z - min_z) / 63.0f;
                int sx = (int)((wz-min_z) / spec->texel_units);
                int sy = (int)floorf(-wy / spec->texel_units);
                if (spec->stagger) {
                    int row = (int)floorf((f32)sy / (spec->crop[3]-spec->crop[1]+1));
                    sx += row * spec->stagger;
                }
                u8 index = pc_house_material_sample(spec->texture, spec->crop,
                    sx, sy);
                unsigned dst = pc_house_ci4_pixel(x, y, 64);
                if (spec->beam_height) {
                    f32 distance = fabsf(wz - (min_z+max_z)*0.5f);
                    f32 horizontal = fabsf(wy - spec->beam_height);
                    if (horizontal < distance) distance = horizontal;
                    for (i = 0; i < spec->vertex_count; i++)
                        for (j = i+1; j < spec->vertex_count; j++) if (edges[i][j] == 1) {
                            f32 d = pc_house_edge_distance(wy, wz, &cache->vertices[i], &cache->vertices[j]);
                            if (d < distance) distance = d;
                        }
                    if (distance < 260.0f) {
                        int across = (int)(distance * (spec->timber[2]-spec->timber[0]+1) / 260.0f);
                        index = pc_house_material_sample(spec->texture, spec->timber,
                                    across, (int)((wy+wz) / spec->texel_units));
                    }
                }
                if (dst & 1) cache->texture[dst / 2] |= index;
                else cache->texture[dst / 2] = index << 4;
            }
            gDPPipeSync(dl++);
            gSPTexture(dl++, 0, 0, 0, G_TX_RENDERTILE, G_ON);
            gDPSetCombineLERP(dl++, TEXEL0, 0, SHADE, 0, 0, 0, 0, TEXEL0,
                             PRIMITIVE, 0, COMBINED, 0, 0, 0, 0, COMBINED);
            gDPSetRenderMode(dl++, G_RM_FOG_SHADE_A, G_RM_AA_ZB_OPA_SURF2);
            gDPLoadTLUT_Dolphin(dl++, 15, 16, 1, anime_1_txt);
            gDPSetTextureImage_Dolphin(dl++, G_IM_FMT_CI, G_IM_SIZ_4b, 64, 64, cache->texture);
            gDPSetTile_Dolphin(dl++, G_DOLPHIN_TLUT_DEFAULT_MODE, 0, 15, GX_CLAMP, GX_CLAMP, 0, 0);
            gDPSetPrimColor(dl++, 0, 128, 255, 255, 255, 255);
            gSPLoadGeometryMode(dl++, G_ZBUFFER | G_SHADE | G_CULL_BACK | G_FOG | G_LIGHTING | G_SHADING_SMOOTH);
            gSPVertex(dl++, cache->vertices, spec->vertex_count, 0);
            for (i = 0; i < spec->triangle_count; i++) {
                const u8* t = spec->triangles + i * 3;
                gSP1Triangle(dl++, t[0], t[1], t[2], 0);
            }
            gSPEndDisplayList(dl++);
            cache->ready = 1;
        }
        *out = cache->list;
        return 1;
    }
    return 0;
}
