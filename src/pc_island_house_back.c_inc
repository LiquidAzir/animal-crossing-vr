/* Fitted island-house walls share the mainland material/cache builder. */
extern cKF_Skeleton_R_c cKF_bs_r_obj_s_myhome_i, cKF_bs_r_obj_s_house_i;
#include "pc_island_house_back_data.c_inc"
static pc_structure_back_cache pc_island_house_back_caches[2];

static int pc_island_house_back_lookup(cKF_Skeleton_R_c* skeleton, Gfx** out) {
    int model;
    if (skeleton == &cKF_bs_r_obj_s_myhome_i) model = 0;
    else if (skeleton == &cKF_bs_r_obj_s_house_i) model = 1;
    else { *out = NULL; return 0; }
    *out = pc_structure_back_build_spec(&pc_island_house_back_specs[model],
                                        &pc_island_house_back_caches[model]);
    /* Recognize unloaded island assets too: never draw a mirrored entrance. */
    return 1;
}
